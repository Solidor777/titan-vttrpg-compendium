  "name": "Flinging Updraft",
  "type": "spell",
  "img": "modules/titan-vttrpg-compendium/icons/traditions/Air_Tradition_Icon.webp",
  "system": {
    "description": "<p>A speeding wind heeds your call, picking someone up and depositing them nearby.</p><p>Choose a target of <strong>Size 1</strong> or smaller within <strong>30 spaces</strong>. It is moved up to 5 spaces in any direction.</p><p>You may choose for the creature to land <strong>Prone</strong>.</p><p>If the creature wishes to resist the movement, it must make an opposed <strong>Resilience</strong> check.</p><p>Each extra success increases the number of spaces by which the target is moved by <strong>+1</strong>.</p><p>Alternatively, you may increase the maximum target <strong>Size</strong> of the target by <strong>+1</strong> per 2 extra successes.</p>",
