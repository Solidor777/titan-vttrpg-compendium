{
  "_id": "Mmh4cYD3F3d0lGrc",
  "name": "Deathsinger's Refrain",
  "type": "effect",
  "img": "icons/magic/death/skull-horned-white-purple.webp",
  "description": "<p>You are <strong>Contaminated</strong> by an infectious disease. At the start of your turn, the singer makes a <strong>4:1 Soul (Metaphysics)</strong> check resisted by your <strong>Resilience</strong>. If it succeeds, you take <strong>Damage</strong> equal to the difference in successes, ignoring <strong>Armor</strong>; otherwise, the effect ends.</p><p>While the singer sustains the effect, creatures adjacent to you also become <strong>Contaminated</strong> and are treated as additional targets.</p>",
